# ==========================================
# TEMPLATE KONFIGURASI LPM KAMPUS
# Salin file ini menjadi '.env' dan sesuaikan nilainya.
# JANGAN commit file '.env' asli ke repository!
# ==========================================

# Lingkungan Aplikasi
# Pilih salah satu: 'development', 'staging', atau 'production'
APP_NAME="LPM Kampus"
APP_ENV=production
APP_URL=https://lpm-kampus.ac.id

# Konfigurasi Database
# Ganti dengan kredensial database server produksi Anda
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db_lpm_kampus_prod
DB_USERNAME=user_lpm_kampus
DB_PASSWORD=Password_Super_Kuat_Dan_Panjang!

# Kunci Rahasia Aplikasi (WAJIB DIISI SAAT PRODUCTION)
# Digunakan untuk mengamankan sesi dan token CSRF.
# Jangan pernah membagikan kunci ini.
# Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Token Cron (WAJIB DIISI)
# Melindungi sim/cron/document_review.php & sim/cron/sync_auto.php.
# Jika kosong, akses cron via web DITOLAK (CLI tetap bisa jalan).
# Generate: php -r "echo bin2hex(random_bytes(32));"
# Panggil via CLI : php sim/cron/sync_auto.php
# Panggil via web : https://domain-anda/sim/cron/sync_auto.php?token=ISI_TOKEN_ANDA
CRON_TOKEN=