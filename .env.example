# ==========================================
# TEMPLATE KONFIGURASI LPM KAMPUS
# Salin file ini menjadi '.env' dan sesuaikan nilainya
# ==========================================

# Lingkungan Aplikasi
# Pilih salah satu: 'development', 'staging', atau 'production'
APP_NAME="LPM Kampus"
APP_ENV=production
APP_URL=https://lpm-kampus.ac.id

# Konfigurasi Database
# Ganti dengan kredensial database server produksi Anda
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db_lpm_kampus_prod
DB_USERNAME=user_lpm_kampus
DB_PASSWORD=Password_Super_Kuat_Dan_Panjang!

# Kunci Rahasia Aplikasi (WAJIB DIISI SAAT PRODUCTION)
# Digunakan untuk mengamankan sesi dan token CSRF.
# Jangan pernah membagikan kunci ini. Generate string acak min. 32 karakter.
APP_KEY=