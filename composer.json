        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}