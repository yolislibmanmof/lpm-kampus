{
    "name": "yolislibmanmof/lpm-kampus",
    "description": "SIM-Mutu LPM — Sistem Informasi Manajemen Penjaminan Mutu Internal",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.6",
